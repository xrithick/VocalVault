# ==========================================
# VocalVault Environment Variables
# ==========================================
# Copy this file to .env and fill in your Supabase credentials:
# cp .env.example .env

# Flask Secret Key for session signing
SECRET_KEY=vocalvault-secret-key-change-in-production

# Supabase Project URL (From Project Settings -> API)
# Example: https://xyzcompany.supabase.co
SUPABASE_URL=your-supabase-project-url

# Supabase API Key (Project Settings -> API -> anon public or service_role secret key)
SUPABASE_KEY=your-supabase-api-key
